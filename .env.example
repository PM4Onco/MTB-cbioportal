# Docker images (gepinnt auf Release 7.1.1)
# Das cBioPortal-Image ist ein privates GHCR-Package (ukf-pauli/cbioportal-image);
# einmalig pro Host vorher:  docker login ghcr.io
# (Benutzername + ein Token mit Read-Pull auf das Package, z. B. Fine-Grained-PAT)
DOCKER_IMAGE_CBIOPORTAL=ghcr.io/ukf-pauli/cbioportal-image:7.1.1-ukf
DOCKER_IMAGE_SESSION_SERVICE=cbioportal/session-service:0.6.4
DOCKER_IMAGE_CLICKHOUSE=clickhouse/clickhouse-server:24.10
DOCKER_IMAGE_PROXY=docker.io/openresty/openresty:1.25.3.1-alpine

# Host-Port des Proxys (einziger veröffentlichter Port)
PORT=8080

# ClickHouse
CLICKHOUSE_DB=cbioportal
CLICKHOUSE_USER=cbio_user
CLICKHOUSE_PASSWORD=somepassword
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
CLICKHOUSE_HOST=cbioportal-database
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=jdbc:ch://cbioportal-database:8123/cbioportal
CLICKHOUSE_OPTIMIZE_BACKOFF_SECS=0
CLICKHOUSE_SETTINGS_PATH=./data/clickhouse_user_settings.xml

# cBioPortal
CBIOPORTAL_SERVER_PORT=8080
SHOW_DEBUG_INFO=true
APPLICATION_PROPERTIES_PATH=./config/application.properties
JAVA_MEM_OPTS=-Xms2g -Xmx4g
LOGO=pm4onco.png

# Externe Dienste (Phase 1: öffentliche Endpunkte)
GENOMENEXUS_URL=https://www.genomenexus.org
ONCOKB_URL=https://public.api.oncokb.org/api/v1
ONCOKB_TOKEN=
QUICKQUECK_URL=https://www.quickqueck.de/search/json/

# Session service
SESSION_SERVICE_SERVER_PORT=5001
SESSION_SERVICE_JAVA_OPTS=-Dspring.data.mongodb.uri=mongodb://cbioportal-session-database:27017/session-service
MONGO_INITDB_DATABASE=session_service

# Optional (docker-compose.frontend.yml): lokaler Frontend-Build, relativ zu diesem Ordner
FRONTEND_DIST=../cbioportal-frontend/dist/reactapp

# Optional (docker-compose.dev.yml): Debug-Overlay — JDWP :5005, Backend direkt :8081,
# ClickHouse :8123/:9000, Mongo :27017. Keine eigenen Umgebungsvariablen.
